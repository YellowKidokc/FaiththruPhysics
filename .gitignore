# faiththruphysics-site .gitignore
# This repo is HTML/CSS/JS only — no media, no build artifacts

# Build scripts (local only, not deployed)
BUILD_SITE.ps1

# Backup files from Kimi edits
*.bak*
*.backup_*
_backups/

# OS junk
Thumbs.db
.DS_Store
desktop.ini

# Python cache (from local server testing)
__pycache__/
*.pyc
.wrangler/

# Temp
*.tmp
*.log
*.local.secret

# Clipboard artifacts
Clipboard Text.txt
"Clipboard Text (*.txt"
MUST DO/Clipboard*

# Backup directories
isomorphism_backup_*/
_link-fix-backup*/
_link-fix-backups/

# Nested git repos
/Family/

# Local working/scratch material; keep off the public site repo
work/
notebooklm_text/

# Source vault / research corpus kept local unless intentionally curated
master-equation/INFO/

# Large media files - hosted on R2 instead
subdomains/shared/media/
*.zip
*.mp4
*.m4a
*.wav
*.mp3

david-os-apps/desk/node_modules/
david-os-apps/desk/dist/
