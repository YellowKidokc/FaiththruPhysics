# ── Cloudflare Worker Secrets ───────────────────────────────────
# Set these with wrangler secret put <NAME> for production.
# For local dev, create a .dev.vars file in this folder.
APP_ID=                   # OAuth application ID
APP_SECRET=               # Application secret (used for JWT signing)
KIMI_AUTH_URL=            # Kimi OAuth server URL (e.g. https://auth.kimi.com)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (e.g. https://auth.kimi.com)
VITE_APP_ID=              # OAuth application ID
VITE_TRPC_API_URL=        # TRPC API endpoint (defaults to /api/trpc)
VITE_OAUTH_CALLBACK_URL=  # OAuth callback URL (defaults to current path + /api/oauth/callback)
