{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "faith-audio-pipeline",
  "main": "src/index.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-06-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ALLOWED_ORIGIN": "*",
    "PUBLIC_AUDIO_BASE_URL": "",
    "DEFAULT_TTS_MODEL": "@cf/deepgram/aura-2-en",
    "DEFAULT_TTS_SPEAKER": "luna",
    "MAX_TEXT_CHARS": "12000",
    "CHUNK_CHARS": "1800"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "faiththruphysics-audio",
      "database_id": "5d669471-8282-4d35-85a3-d19fede07f57"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO_BUCKET",
      "bucket_name": "faiththruphysics-audio"
    }
  ]
}
